PORT=5001
SUPABASE_URL=https://your-supabase-project.supabase.co
SUPABASE_SERVICE_KEY=your-supabase-service-role-key
SUPABASE_ANON_KEY=your-supabase-anon-key
GAS_URL=https://script.google.com/macros/s/.../exec

# Shared secret for external cron services (e.g. cron-job.org) hitting
# POST /api/cron/check?secret=... or with header X-Cron-Secret: ...
CRON_SECRET=change-me-to-a-long-random-string

# Telegram Bot API token, from @BotFather (https://t.me/BotFather)
TELEGRAM_BOT_TOKEN=

# Discord webhook URL is stored per-user in Supabase, not here.

# YouTube PubSubHubbub webhook (real-time upload notifications)
# Must be a publicly reachable HTTPS URL, e.g. https://your-backend.onrender.com/api/youtube/webhook
PUBLIC_BACKEND_URL=

